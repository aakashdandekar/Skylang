{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Skylang",
    "scopeName": "source.sky",
    "patterns": [
        { "include": "#comments" },
        { "include": "#fstrings" },
        { "include": "#embedded_foreign_code" },
        { "include": "#strings" },
        { "include": "#chars" },
        { "include": "#constants" },
        { "include": "#keywords" },
        { "include": "#types" },
        { "include": "#class_decl" },
        { "include": "#fn_decl" },
        { "include": "#extern_decl" },
        { "include": "#this_field" },
        { "include": "#builtins" },
        { "include": "#stdlib_modules" },
        { "include": "#stdlib_methods" },
        { "include": "#collection_methods" },
        { "include": "#properties" },
        { "include": "#operators" },
        { "include": "#numbers" },
        { "include": "#function_calls" },
        { "include": "#identifiers" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.sky",
                    "match": "//.*$"
                },
                {
                    "name": "comment.line.number-sign.sky",
                    "match": "#.*$"
                },
                {
                    "name": "comment.block.sky",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "fstrings": {
            "patterns": [
                {
                    "name": "string.interpolated.double.sky",
                    "begin": "(?<![a-zA-Z0-9_])[fF]\"",
                    "end": "\"",
                    "beginCaptures": {
                        "0": { "name": "string.interpolated.double.sky" }
                    },
                    "endCaptures": {
                        "0": { "name": "string.interpolated.double.sky" }
                    },
                    "patterns": [
                        {
                            "name": "constant.character.escape.sky",
                            "match": "\\\\([nrtvfb0\"'\\\\]|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4})"
                        },
                        {
                            "name": "constant.character.escape.brace.sky",
                            "match": "\\{\\{|\\}\\}"
                        },
                        {
                            "name": "meta.embedded.expression.sky",
                            "begin": "\\{",
                            "end": "\\}",
                            "beginCaptures": {
                                "0": { "name": "punctuation.definition.template-expression.begin.sky" }
                            },
                            "endCaptures": {
                                "0": { "name": "punctuation.definition.template-expression.end.sky" }
                            },
                            "patterns": [
                                { "include": "$self" }
                            ]
                        }
                    ]
                },
                {
                    "name": "string.interpolated.single.sky",
                    "begin": "(?<![a-zA-Z0-9_])[fF]'",
                    "end": "'",
                    "beginCaptures": {
                        "0": { "name": "string.interpolated.single.sky" }
                    },
                    "endCaptures": {
                        "0": { "name": "string.interpolated.single.sky" }
                    },
                    "patterns": [
                        {
                            "name": "constant.character.escape.sky",
                            "match": "\\\\([nrtvfb0\"'\\\\]|x[0-9a-fA-F]{2})"
                        },
                        {
                            "name": "constant.character.escape.brace.sky",
                            "match": "\\{\\{|\\}\\}"
                        },
                        {
                            "name": "meta.embedded.expression.sky",
                            "begin": "\\{",
                            "end": "\\}",
                            "beginCaptures": {
                                "0": { "name": "punctuation.definition.template-expression.begin.sky" }
                            },
                            "endCaptures": {
                                "0": { "name": "punctuation.definition.template-expression.end.sky" }
                            },
                            "patterns": [
                                { "include": "$self" }
                            ]
                        }
                    ]
                }
            ]
        },
        "embedded_foreign_code": {
            "patterns": [
                {
                    "name": "meta.embedded.block.python.sky",
                    "begin": "(?<=\\bpython\\.(?:exec|compile)\\s*\\(\\s*)\\{",
                    "end": "\\}(?=\\s*\\))",
                    "patterns": [
                        { "include": "source.python" }
                    ]
                },
                {
                    "name": "meta.embedded.block.python.sky",
                    "begin": "(?<=\\bpython\\.(?:exec|compile)\\s*\\(\\s*)([\"'])",
                    "end": "\\1",
                    "patterns": [
                        { "include": "source.python" }
                    ]
                },
                {
                    "name": "meta.embedded.block.javascript.sky",
                    "begin": "(?<=\\bjs\\.(?:exec|compile)\\s*\\(\\s*)\\{",
                    "end": "\\}(?=\\s*\\))",
                    "patterns": [
                        { "include": "source.js" }
                    ]
                },
                {
                    "name": "meta.embedded.block.javascript.sky",
                    "begin": "(?<=\\bjs\\.(?:exec|compile)\\s*\\(\\s*)([\"'])",
                    "end": "\\1",
                    "patterns": [
                        { "include": "source.js" }
                    ]
                },
                {
                    "name": "meta.embedded.block.cpp.sky",
                    "begin": "(?<=\\bcpp\\.(?:exec|compile)\\s*\\(\\s*)\\{",
                    "end": "\\}(?=\\s*\\))",
                    "patterns": [
                        { "include": "source.cpp" }
                    ]
                },
                {
                    "name": "meta.embedded.block.cpp.sky",
                    "begin": "(?<=\\bcpp\\.(?:exec|compile)\\s*\\(\\s*)([\"'])",
                    "end": "\\1",
                    "patterns": [
                        { "include": "source.cpp" }
                    ]
                },
                {
                    "name": "meta.embedded.block.go.sky",
                    "begin": "(?<=\\bgolang\\.(?:exec|compile)\\s*\\(\\s*)\\{",
                    "end": "\\}(?=\\s*\\))",
                    "patterns": [
                        { "include": "source.go" }
                    ]
                },
                {
                    "name": "meta.embedded.block.go.sky",
                    "begin": "(?<=\\bgolang\\.(?:exec|compile)\\s*\\(\\s*)([\"'])",
                    "end": "\\1",
                    "patterns": [
                        { "include": "source.go" }
                    ]
                },
                {
                    "name": "meta.embedded.block.rust.sky",
                    "begin": "(?<=\\brust\\.(?:exec|compile)\\s*\\(\\s*)\\{",
                    "end": "\\}(?=\\s*\\))",
                    "patterns": [
                        { "include": "source.rust" }
                    ]
                },
                {
                    "name": "meta.embedded.block.rust.sky",
                    "begin": "(?<=\\brust\\.(?:exec|compile)\\s*\\(\\s*)([\"'])",
                    "end": "\\1",
                    "patterns": [
                        { "include": "source.rust" }
                    ]
                },
                {
                    "name": "meta.embedded.block.java.sky",
                    "begin": "(?<=\\bjava\\.(?:exec|compile)\\s*\\(\\s*)\\{",
                    "end": "\\}(?=\\s*\\))",
                    "patterns": [
                        { "include": "source.java" }
                    ]
                },
                {
                    "name": "meta.embedded.block.java.sky",
                    "begin": "(?<=\\bjava\\.(?:exec|compile)\\s*\\(\\s*)([\"'])",
                    "end": "\\1",
                    "patterns": [
                        { "include": "source.java" }
                    ]
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.sky",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.sky",
                            "match": "\\\\([nrtvfb0\"'\\\\]|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4})"
                        },
                        {
                            "name": "invalid.illegal.escape.sky",
                            "match": "\\\\[^nrtvfb0\"'\\\\]"
                        }
                    ]
                }
            ]
        },
        "chars": {
            "patterns": [
                {
                    "name": "string.quoted.single.sky",
                    "begin": "'",
                    "end": "'",
                    "patterns": [
                        {
                            "name": "constant.character.escape.sky",
                            "match": "\\\\([nrtvfb0\"'\\\\]|x[0-9a-fA-F]{2})"
                        }
                    ]
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.boolean.sky",
                    "match": "\\b(true|false)\\b"
                },
                {
                    "name": "constant.language.nil.sky",
                    "match": "\\b(none)\\b"
                },
                {
                    "name": "constant.language.math.sky",
                    "match": "\\b(math\\.(pi|e|inf|nan))\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.sky",
                    "match": "\\b(if|else|elif|for|in|while|break|continue|return|async|await|spawn)\\b"
                },
                {
                    "name": "keyword.declaration.function.sky",
                    "match": "\\bf\\b"
                },
                {
                    "name": "keyword.declaration.class.sky",
                    "match": "\\bclass\\b"
                },
                {
                    "name": "keyword.other.init.sky",
                    "match": "\\binit\\b"
                },
                {
                    "name": "variable.language.this.sky",
                    "match": "\\bthis\\b"
                },
                {
                    "name": "keyword.control.takes.sky",
                    "match": "\\btakes\\b"
                },
                {
                    "name": "keyword.control.import.sky",
                    "match": "\\b(import|from|as|cimport|extern)\\b"
                },
                {
                    "name": "keyword.operator.logical.sky",
                    "match": "\\b(and|or|not)\\b"
                },
                {
                    "name": "keyword.operator.new.sky",
                    "match": "\\bnew\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "storage.type.scalar.sky",
                    "match": "\\b(I|D|B|C|S)\\b(?=\\s+([a-zA-Z_]|\\=))"
                },
                {
                    "name": "storage.type.scalar.sky",
                    "match": "(?<=\\s)(I|D|B|C|S)\\b"
                },
                {
                    "name": "storage.type.collection.sky",
                    "match": "\\b(list|dict|set|pair|file|future)\\b"
                },
                {
                    "name": "storage.type.builtin.sky",
                    "match": "\\b(int|double|bool|char|string|array|list|tuple|dict|set|sortedList|type)\\b"
                }
            ]
        },
        "class_decl": {
            "match": "\\b(class)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
            "captures": {
                "1": { "name": "keyword.declaration.class.sky" },
                "2": { "name": "entity.name.type.class.sky" }
            }
        },
        "fn_decl": {
            "match": "\\b(?:(async)\\s+)?(f)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
            "captures": {
                "1": { "name": "keyword.control.sky" },
                "2": { "name": "keyword.declaration.function.sky" },
                "3": { "name": "entity.name.function.sky" }
            }
        },
        "extern_decl": {
            "match": "\\b(extern)\\s+(f)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
            "captures": {
                "1": { "name": "keyword.control.import.sky" },
                "2": { "name": "keyword.declaration.function.sky" },
                "3": { "name": "entity.name.function.extern.sky" }
            }
        },
        "this_field": {
            "match": "\\b(this)\\.([a-zA-Z_][a-zA-Z0-9_]*)",
            "captures": {
                "1": { "name": "variable.language.this.sky" },
                "2": { "name": "variable.other.property.sky" }
            }
        },
        "builtins": {
            "patterns": [
                {
                    "name": "support.function.builtin.sky",
                    "match": "\\b(print|println|open|input|hex|bin|oct|format|range|len|type|takes|error|panic|gc|free|eval|split|join|upper|lower|trim|trimleft|trimright|contains|startswith|endswith|replace|find|count|reverse|chars|bytes)\\b(?=\\s*\\()"
                },
                {
                    "name": "variable.language.special.sky",
                    "match": "\\b(args|_)\\b"
                }
            ]
        },
        "stdlib_modules": {
            "patterns": [
                {
                    "name": "support.class.module.sky",
                    "match": "\\b(math|python|js|cpp|java|golang|rust|async)\\b"
                }
            ]
        },
        "stdlib_methods": {
            "patterns": [
                {
                    "match": "(?<=\\bmath\\.)(sqrt|sin|cos|tan|asin|acos|atan|atan2|abs|ceil|floor|round|log|log10|log2|exp|pow|min|max|hypot|clamp)\\b",
                    "name": "support.function.math.sky"
                },
                {
                    "match": "(?<=\\basync\\.)(sleep|all|race|spawn)\\b",
                    "name": "support.function.async.sky"
                },
                {
                    "match": "(?<=\\b(python|js|cpp|java|golang|rust)\\.)(load|exec|compile|version)\\b",
                    "name": "support.function.interop.sky"
                }
            ]
        },
        "collection_methods": {
            "patterns": [
                {
                    "match": "(?<=\\.)(push|pop|clear|add|has|value|split|join|format|upper|lower|trim|trimleft|trimright|contains|startswith|endswith|replace|find|count|reverse|rjust|ljust|center|zfill|read|write|readline|readlines|close|chars|bytes|await|cancel)\\b(?=\\s*\\()",
                    "name": "support.function.collection.sky"
                }
            ]
        },
        "properties": {
            "patterns": [
                {
                    "match": "(?<=\\.)(size|length|chars|bytes|T|is_done|result|error|state)\\b",
                    "name": "support.variable.property.sky"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.assignment.walrus.sky",
                    "match": ":="
                },
                {
                    "name": "keyword.operator.assignment.compound.sky",
                    "match": "\\+=|-=|\\*=|/="
                },
                {
                    "name": "keyword.operator.comparison.sky",
                    "match": "==|!=|<=|>=|<|>"
                },
                {
                    "name": "keyword.operator.assignment.sky",
                    "match": "=(?!=)"
                },
                {
                    "name": "keyword.operator.arithmetic.sky",
                    "match": "//|\\+|\\-|\\*|/|\\^|%"
                },
                {
                    "name": "keyword.operator.logical.sky",
                    "match": "&&|\\|\\||!"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.float.sky",
                    "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b|(?<=[^\\w.])\\.\\d+([eE][+-]?\\d+)?\\b"
                },
                {
                    "name": "constant.numeric.hex.sky",
                    "match": "\\b0[xX][0-9a-fA-F]+\\b"
                },
                {
                    "name": "constant.numeric.binary.sky",
                    "match": "\\b0[bB][01]+\\b"
                },
                {
                    "name": "constant.numeric.octal.sky",
                    "match": "\\b0[oO][0-7]+\\b"
                },
                {
                    "name": "constant.numeric.integer.sky",
                    "match": "\\b\\d+\\b"
                }
            ]
        },
        "function_calls": {
            "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
            "captures": {
                "1": { "name": "entity.name.function.call.sky" }
            }
        },
        "identifiers": {
            "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b",
            "name": "variable.other.sky"
        }
    }
}
