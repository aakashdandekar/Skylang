// tests/test_all.sky - Comprehensive Test Suite for Skylang

println("Running Skylang Test Suite...")

// 1. Basic Types & Arithmetic
a := 10
b := 20
c := a + b
if c != 30 { panic("Test failed: addition") }

d := 100 // 3
if d != 33 { panic("Test failed: floordiv") }

p := 2 ^ 8
if p != 256 { panic("Test failed: power") }

// 2. Collections
list := [1, 2, 3]
list.push(4)
if list.size != 4 { panic("Test failed: list push/size") }
if list[3] != 4 { panic("Test failed: list index") }

dict := {"x": 100, "y": 200}
if dict["x"] != 100 { panic("Test failed: dict index") }
if !dict.has("y") { panic("Test failed: dict has") }

tuple := (10, 20, 30)
if tuple.size != 3 { panic("Test failed: tuple size") }
if tuple[1] != 20 { panic("Test failed: tuple index") }

// 3. Control Flow
sum := 0
for x in [10, 20, 30] {
    sum += x
}
if sum != 60 { panic("Test failed: for in list") }

loop_count := 0
while loop_count < 5 {
    loop_count += 1
}
if loop_count != 5 { panic("Test failed: while loop") }

// 4. Functions & Gateway
f add {
    takes(x, y)
    return x + y
}
if add(15, 25) != 40 { panic("Test failed: function add") }
if add(y=30, x=10) != 40 { panic("Test failed: named args gateway") }

// 5. Standard Library (math, fmt, io) and Built-in Strings
if math.sqrt(64) != 8 { panic("Test failed: math.sqrt") }
if math.abs(-10) != 10 { panic("Test failed: math.abs") }
if math.min(5, 9) != 5 { panic("Test failed: math.min") }
if math.max(5, 9) != 9 { panic("Test failed: math.max") }

if "sky".upper() != "SKY" || upper("sky") != "SKY" { panic("Test failed: upper") }
if "SKY".lower() != "sky" || lower("SKY") != "sky" { panic("Test failed: lower") }
if "  abc  ".trim() != "abc" || trim("  abc  ") != "abc" { panic("Test failed: trim") }
if "hello".replace("l", "w") != "hewwo" || replace("hello", "l", "w") != "hewwo" { panic("Test failed: replace") }
if "skylang".startswith("sky") != true || startswith("skylang", "sky") != true { panic("Test failed: startswith") }
if "skylang".endswith("lang") != true || endswith("skylang", "lang") != true { panic("Test failed: endswith") }
if "skylang".contains("ylan") != true || contains("skylang", "ylan") != true { panic("Test failed: contains") }
if "skylang".find("lan") != 3 || find("skylang", "lan") != 3 { panic("Test failed: find") }
if "banana".count("a") != 3 || count("banana", "a") != 3 { panic("Test failed: count") }
if "sky".reverse() != "yks" || reverse("sky") != "yks" { panic("Test failed: reverse") }
if "a,b,c".split(",").size != 3 || split("a,b,c", ",").size != 3 { panic("Test failed: split") }
if ", ".join(["a", "b", "c"]) != "a, b, c" || join(["a", "b", "c"], ", ") != "a, b, c" { panic("Test failed: join") }
if ["a", "b", "c"].join(", ") != "a, b, c" { panic("Test failed: list join") }
if "sky".chars.size != 3 || chars("sky").size != 3 { panic("Test failed: chars") }
if "ABC".bytes[0] != 65 || bytes("ABC")[0] != 65 { panic("Test failed: bytes") }

formatted := fmt.format("Number: {}", 42)
if formatted != "Number: 42" { panic("Test failed: fmt.format") }
if fmt.hex(255) != "ff" { panic("Test failed: fmt.hex") }

tmp := "/tmp/skylang_test_file.txt"
io.writefile(tmp, "hello test\n")
if !io.exists(tmp) { panic("Test failed: io.exists") }
txt := io.readfile(tmp)
if txt.trim() != "hello test" || trim(txt) != "hello test" { panic("Test failed: io.readfile") }
io.remove(tmp)
if io.exists(tmp) { panic("Test failed: io.remove") }

// 6. Error handling / Multi-return
f div_safe {
    takes(a, b)
    if b == 0 {
        return 0, error("zero division")
    }
    return a / b, none
}

res, err := div_safe(10, 2)
if err != none || res != 5 { panic("Test failed: div_safe success") }

res2, err2 := div_safe(10, 0)
if err2 == none { panic("Test failed: div_safe error") }

// 7. Skylang Built-in eval function
eval_num := eval("2 * 10 + 50")
if eval_num != 70 { panic("Test failed: builtin eval num") }

eval_str := eval("\"sky\" + \"lang\"")
if eval_str != "skylang" { panic("Test failed: builtin eval str") }

eval_list := eval("[10, 20, 30]")
if eval_list.size != 3 || eval_list[1] != 20 { panic("Test failed: builtin eval list") }

// 8. Python Interoperability
import python
py_math := python.load("math")
if py_math.sqrt(100) != 10 { panic("Test failed: python math.sqrt") }
python.exec("
def py_cube(x):
    return x * x * x
")
main_py := python.load("__main__")
if main_py.py_cube(4) != 64 { panic("Test failed: python exec & call") }

// 9. JavaScript / NPM Interoperability (Unified JS & NPM)
import js
js_math := js.load("Math")
if js_math.sqrt(169) != 13 { panic("Test failed: js Math.sqrt") }
if js_math.pow(2, 6) != 64 { panic("Test failed: js Math.pow") }

// 10. C++ Interoperability & JIT Compilation
import cpp
cpp_math := cpp.compile("
extern \"C\" {
    double fast_cube(double x) {
        return x * x * x;
    }
}
")
if cpp_math.fast_cube(4.0) != 64 { panic("Test failed: cpp.compile JIT") }

// 11. Java Interoperability
import java
java_math := java.load("java.lang.Math")
if java_math.max(12, 99) != 99 { panic("Test failed: java Math.max") }
if java_math.sqrt(225.0) != 15 { panic("Test failed: java Math.sqrt") }

// 12. Golang Interoperability & JIT Compilation
import go, golang
go_math := go.load("math")
if go_math.Sqrt(625.0) != 25 { panic("Test failed: go math.Sqrt") }
go_calc := go.compile("
//export DoubleVal
func DoubleVal(x float64) float64 {
    return x * 2.0
}
")
if go_calc.DoubleVal(21.0) != 42 { panic("Test failed: go.compile JIT") }

// 13. Rust Interoperability & JIT Compilation
import rust
rust_math := rust.load("std::f64::consts")
if rust_math.PI < 3.14 || rust_math.PI > 3.15 { panic("Test failed: rust math.PI") }
rust_calc := rust.compile("
#[no_mangle]
pub extern \"C\" fn square(x: f64) -> f64 {
    x * x
}
")
if rust_calc.square(9.0) != 81 { panic("Test failed: rust.compile JIT") }

println("All Skylang tests passed successfully! [100% OK]")
