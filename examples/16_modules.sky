// 16_modules.sky - Demonstrating multi-file imports and standard libraries

import "math_utils.sky"
import "sub/helper.sky"
import random, time, math

println("=== Skylang Multi-File Modules & Stdlib Demo ===")

// 1. Functions from same-directory module (via module namespace and directly)
println("\n--- Same-directory module (math_utils.sky) ---")
println("math_utils.PI:", math_utils.PI)
println("math_utils.add(10, 25):", math_utils.add(10, 25))
println("Direct add(15, 35):", add(15, 35))
println("Direct multiply(6, 7):", multiply(6, 7))

// 2. Class from same-directory module
calc := math_utils.Calculator("MasterCalc")
println("Calculator instance name:", calc.name)
println("calc.computeSum(100, 200):", calc.computeSum(100, 200))
println("calc.computeProduct(5, 8):", calc.computeProduct(5, 8))
println("calc.getHistory():", calc.getHistory())

calc2 := Calculator("DirectCalc")
println("Direct Calculator computeSum(7, 3):", calc2.computeSum(7, 3))

// 3. Subdirectory module (sub/helper.sky)
println("\n--- Sub-directory module (sub/helper.sky) ---")
println("helper.formatGreeting:", helper.formatGreeting("Dr.", "Watson"))
println("Direct formatGreeting:", formatGreeting("Mr.", "Holmes"))

g := helper.Greeter("Welcome to Skylang,")
println("Greeter instance greet:", g.greet("Alice"))

g2 := Greeter("Greetings,")
println("Direct Greeter greet:", g2.greet("Bob"))

// 4. Random module
println("\n--- Random Module ---")
r_int := random.randint(1, 100)
println("random.randint(1, 100):", r_int)
r_flt := random.random()
println("random.random():", r_flt)
r_choice := random.choice(["apple", "banana", "cherry", "dragonfruit"])
println("random.choice:", r_choice)

list_to_shuffle := [1, 2, 3, 4, 5]
random.shuffle(list_to_shuffle)
println("random.shuffle:", list_to_shuffle)

// 5. Time module
println("\n--- Time Module ---")
t_start := time.time()
println("Current Unix time:", t_start)
time.sleep(0.05)
t_end := time.time()
println("Elapsed time after 0.05s sleep:", t_end - t_start)
println("CPU clock:", time.clock())

println("\nAll module and library checks passed successfully!")
