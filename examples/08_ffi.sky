// 08_ffi.sky - Demonstrating Foreign Function Interface (FFI)
// Skylang can directly declare and bind extern C functions!

extern f cos(x)
extern f sin(x)
extern f sqrt(x)
extern f atan2(y, x)

println("=== Skylang FFI Demo ===")
println("C cos(0.0):", cos(0.0))
println("C sin(0.0):", sin(0.0))
println("C sqrt(625.0):", sqrt(625.0))
println("C atan2(1.0, 1.0):", atan2(1.0, 1.0))
