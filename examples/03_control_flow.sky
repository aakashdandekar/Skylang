// Skylang Control Flow Example
// Demonstrating if, elif, else, and unified for loops

// 1. If / Elif / Else
I score = 85

if score >= 90 {
    print("Grade: A")
} elif score >= 80 {
    print("Grade: B")
} elif score >= 70 {
    print("Grade: C")
} else {
    print("Grade: F")
}

// 2. For with condition (like while)
print("Counting with for condition:")
I count = 0
for count < 3 {
    print("count is:", count)
    count += 1
}

// 3. For in collection
print("Iterating over a list:")
names := ["Alice", "Bob", "Charlie"]
for name in names {
    print("Hello,", name)
}

print("Iterating over a string:")
S greeting = "Sky"
for ch in greeting {
    print("char:", ch)
}

// 4. Infinite loop with break
print("Loop with break:")
I n = 0
for {
    if n >= 3 {
        break
    }
    print("n is:", n)
    n += 1
}
